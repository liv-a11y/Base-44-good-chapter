{
  "name": "Guest",
  "description": "Someone the starter named. Their private ideas stay on their own record and are never shown to another guest.",
  "type": "object",
  "properties": {
    "chapter_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "description": "Optional. Stored, never used for messaging."
    },
    "approved": {
      "type": "boolean",
      "default": false,
      "description": "Set once the person approves the guest list."
    },
    "invited_at": {
      "type": "string"
    },
    "guest_token": {
      "type": "string",
      "description": "Unguessable private link token. One per guest, created when the chapter goes out."
    },
    "ideas": {
      "type": "string",
      "description": "This guest's own three ideas, stored as JSON. Only ever returned for this guest's own link."
    },
    "shared_idea": {
      "type": "string",
      "description": "The one idea this guest chose to pass to the curator. An idea, never an item."
    },
    "shared_idea_note": {
      "type": "string"
    }
  },
  "required": [
    "chapter_id",
    "name",
    "email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}