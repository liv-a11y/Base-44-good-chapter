{
  "name": "Waitlist",
  "description": "An invitation request from the public site.",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "interest": {
      "type": "string",
      "enum": [
        "Consumer",
        "Founding partner: Employer",
        "Founding partner: Real estate",
        "Founding partner: Brand",
        "Investor",
        "General inquiry"
      ]
    },
    "comments": {
      "type": "string",
      "description": "Optional note. Callers are asked to leave out other people's names and health details."
    }
  },
  "required": [
    "email",
    "interest"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}