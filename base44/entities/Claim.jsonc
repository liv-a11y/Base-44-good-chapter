{
  "name": "Claim",
  "description": "Which guest is giving which item, and the name shown next to it.",
  "type": "object",
  "properties": {
    "chapter_id": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "guest_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string",
      "description": "What is shown next to what they give, such as The Jones Family. Empty means Someone who cares."
    },
    "claimed_at": {
      "type": "string"
    }
  },
  "required": [
    "chapter_id",
    "item_id",
    "guest_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}