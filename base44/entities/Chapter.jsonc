{
  "name": "Chapter",
  "description": "One chapter: the person it is for, the starter who asked, and where it sits in the process.",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string",
      "description": "Short code the starter can quote. Not a secret link."
    },
    "person_name": {
      "type": "string"
    },
    "person_email": {
      "type": "string"
    },
    "person_token": {
      "type": "string",
      "description": "Private link token. The person is the only one who receives it."
    },
    "accept_token": {
      "type": "string",
      "description": "Single purpose token for the accept button in the letter. Replaced every time the chapter is sent."
    },
    "decline_token": {
      "type": "string",
      "description": "Single purpose token for the send it back button in the letter. Replaced every time the chapter is sent."
    },
    "person_decision": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ],
      "default": "pending",
      "description": "The person answers first. Nothing reaches the guests before an answer."
    },
    "person_decided_at": {
      "type": "string"
    },
    "person_decline_reason": {
      "type": "string",
      "description": "Optional words from the person when they send the chapter back."
    },
    "chapter_type": {
      "type": "string",
      "enum": [
        "First home, alone",
        "Divorce",
        "Coming out",
        "After a health scare",
        "Moving in together",
        "New city",
        "New job",
        "A big lifestyle change",
        "Adoption",
        "Retirement",
        "Something else"
      ]
    },
    "starter_name": {
      "type": "string"
    },
    "starter_email": {
      "type": "string"
    },
    "story_line": {
      "type": "string",
      "description": "One line about the chapter, written by the curator."
    },
    "always_wears": {
      "type": "string"
    },
    "rewatches": {
      "type": "string"
    },
    "never_buys": {
      "type": "string"
    },
    "starter_ideas": {
      "type": "string",
      "description": "The one idea the starter kept from the interview. An idea only, never an approved item."
    },
    "path": {
      "type": "string",
      "enum": [
        "anchor_gift",
        "employer_pool"
      ],
      "enumColors": [
        "blue",
        "green"
      ],
      "default": "anchor_gift",
      "description": "How the starter opens the chapter: one gift they would give first, or a per person pool from work."
    },
    "anchor_idea": {
      "type": "string",
      "description": "The one gift the starter would give first. The curator starts here. An idea only, never an approved item."
    },
    "anchor_note": {
      "type": "string"
    },
    "pool_employer": {
      "type": "string",
      "description": "Who set the pool aside. Shown on the desk, never to a guest."
    },
    "pool_amount": {
      "type": "number",
      "description": "Per person amount set at the start of the benefit term. No money moves through this site."
    },
    "pool_term": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "started",
        "curating",
        "with_person_items",
        "with_person_guests",
        "sent_to_guests",
        "closed",
        "declined"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "blue",
        "blue",
        "green",
        "gray",
        "red"
      ],
      "default": "started"
    },
    "state_changed_at": {
      "type": "string",
      "description": "When the chapter entered its current state. Falls back to created_date."
    },
    "is_sample": {
      "type": "boolean",
      "default": false,
      "description": "Seeded example data. Always shown with a SAMPLE label."
    }
  },
  "required": [
    "person_name",
    "chapter_type",
    "state"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}